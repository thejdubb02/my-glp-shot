# Runtime secrets. The pattern is deliberately wide: the literal rule used to be
# "docker/api.env", which did not match docker/api.env.bak-* — so two backups of
# the file, carrying live Stripe and Resend keys, were committed on 2026-08-24
# and only GitHub push protection stopped them reaching the remote.
docker/api.env*
*.env
*.env.bak*

web/landing/*.bak.*
__pycache__/
*.pyc
node_modules/
build/
# Generated by cap sync (also listed in android/.gitignore, repeated here for tools that only read this file)
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor*.json
android/capacitor-cordova-android-plugins/
android/app/build/
android/build/
android/.gradle/
