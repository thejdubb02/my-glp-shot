        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Log weight",
      "short_name": "Weight",
      "description": "Open the weight logger",
      "url": "./?action=log-weight",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Insights",
      "short_name": "Insights",
      "description": "See patterns in your data",
      "url": "./?tab=insights",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "prefer_related_applications": false
