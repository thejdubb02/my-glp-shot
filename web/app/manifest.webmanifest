{
  "id": "/",
  "name": "My GLP Shot",
  "short_name": "My GLP Shot",
  "description": "Track your GLP-1 / peptide shots, weight, side effects. Local-first, end-to-end encrypted sync.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#f6faf9",
  "theme_color": "#0f766e",
  "categories": [
    "health",
    "medical",
    "lifestyle"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
